// Regras de segurança do Firestore — Nossa Casa (já publicadas no Firebase)
// Só quem estiver logado lê e grava. O cadastro público está DESLIGADO
// (Authentication → Configurações → Ações do usuário), então só existem
// os logins criados manualmente no painel do Firebase.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
