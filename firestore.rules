// Regras de segurança do Firestore — Nossa Casa
// Cole este texto em: Firebase → Firestore Database → aba "Regras" → Publicar.
// Troque os dois e-mails pelos e-mails de login de vocês (os mesmos criados em Authentication).
// Só esses dois e-mails conseguem ler e gravar qualquer dado.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in [
          'EMAIL_DO_GABRIEL@exemplo.com',
          'EMAIL_DA_REBECA@exemplo.com'
        ];
    }
  }
}
